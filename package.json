{
  "name": "ai-job-accessibility",
  "version": "1.0.0",
  "description": "AI-powered platform for job accessibility for disabled persons",
  "scripts": {
    "install:frontend": "cd frontend && npm install",
    "start:backend": "cd backend-java && mvn spring-boot:run",
    "start:frontend": "cd frontend && npm start",
    "build:backend": "cd backend-java && mvn clean package -DskipTests",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build": "cd frontend && npm install && npm run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "accessibility",
    "job",
    "ai",
    "resume",
    "disabled"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "mongodb": "^7.1.1"
  }
}
