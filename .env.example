# ==========================================
# WorkAble AI Job Accessibility Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to Git!
# ==========================================

# Server Port
PORT=5001

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_job_accessibility
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/ai-job-accessibility

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# AI & LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here

# Context Engine Service
CONTEXT_ENGINE_URL=http://127.0.0.1:8000
CONTEXT_ENGINE_API_KEY=test-api-key
KNOWLEDGE_BASE_ID=kb-workable-001

# Job Aggregation & Freshness Settings
JOB_FRESHNESS_HOURS=6
MIN_RECOMMENDATION_JOBS=20
JOB_SYNC_INTERVAL_HOURS=6
JOB_SYNC_INTERVAL_MS=21600000
JOB_SYNC_ENABLED=true

# External Job Provider API Keys
JOOBLE_API_KEY=your_jooble_api_key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key
ADZUNA_COUNTRY=us
JSEARCH_API_KEY=your_rapidapi_jsearch_key
JSEARCH_HOST=jsearch.p.rapidapi.com
