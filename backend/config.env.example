PORT=5001
NODE_ENV=production

# MongoDB Atlas URI (include database name)
# If SRV DNS fails on your network, use non-SRV URI with all shard hosts.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/ai-job-accessibility?retryWrites=true&w=majority

# JWT Secret (use a long random value in production)
JWT_SECRET=replace_with_a_long_random_secret_value

# Gemini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Optional APIs
SKILLS_API_BASE_URL=https://api.dataatwork.org/v1
SKILLS_API_TIMEOUT_MS=10000

# Optional Twilio (leave empty if not used)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional LinkedIn
LINKEDIN_API_KEY=
LINKEDIN_CLIENT_SECRET=
